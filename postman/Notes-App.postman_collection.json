{
  "info": {
    "_postman_id": "e2f08d1d-8f53-4b1f-8ec5-1f85af2735cf",
    "name": "Notes App Local API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "noteId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "GET All Notes",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/notes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "notes"
          ]
        }
      },
      "response": []
    },
    {
      "name": "POST Create Note",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "var json = pm.response.json();",
              "if (json && json.note && json.note.id) {",
              "    pm.collectionVariables.set('noteId', json.note.id);",
              "} else if (json && json.id) {",
              "    pm.collectionVariables.set('noteId', json.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"judul\": \"Catatan dari Postman\",\n  \"isi\": \"Ini dibuat lewat collection\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/notes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "notes"
          ]
        }
      },
      "response": []
    },
    {
      "name": "PUT Update Note (by noteId)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"judul\": \"Catatan update dari Postman\",\n  \"isi\": \"Isi catatan sudah diperbarui\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/notes/{{noteId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "notes",
            "{{noteId}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "DELETE Note (by noteId)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/notes/{{noteId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "notes",
            "{{noteId}}"
          ]
        }
      },
      "response": []
    }
  ]
}
